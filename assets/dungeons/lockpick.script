# Prove, in the real renderer: we can reach a lock, the camera turns to face
# it, the puzzle can be solved, and the player then walks through the gate.
report

# --- Door 0: the padlock -------------------------------------------------
# Door 0's lock is a pin tumbler, and a pin-tumbler door wears the imported
# padlock model (assets/dungeons/padlock). The puzzle is unchanged -- four
# bores, four heights, all-or-nothing -- so every assertion about pin state
# below is the same one it always was; what is new is that the lock on screen
# is an animated model, and the padlock_pin_moved checks are what prove the
# clips actually reached it.
facing_of 0
facing_of 1
teleport_door 0
# Aim 130 degrees away from the lock first: if the camera did not turn, the
# facing check below could only pass by luck.
set_yaw 220
wait 0.5
expect phase exploring
expect door_shut 0
capture lockpick_01_approach.png

press interact
wait 2.0
expect phase pin
expect focus 0.98
expect facing 3.0
expect aimed 2.0
# At the requested 90-degree head-on pose the keyway runs into screen depth;
# moving the mouse slightly off-axis reveals the pin spacing.
#
# Focusing brings the carried light up beside the lock, but this inspection
# view deliberately hides both the imported torch mesh and the animated flame.
# The light itself must remain active so the mechanism stays readable.
expect torch_hidden
expect torch_lit
report
capture lockpick_02_facing_pin_tumbler.png

# WASD does not walk while a lock is up -- there is nowhere to walk -- so it
# nudges the inspection view instead, the same bounded offsets the mouse
# writes. `walk` drives exactly the move_forward/move_right a held key does, so
# this is the real binding and not a stand-in for it. Panning and panning back
# by the same amount has to land on centre again, or the offsets are leaking.
walk 0 1 0.4
expect view_panned 8
# ...and the view keys must not have touched the puzzle on the way past.
expect pin_height 0 0
expect pin_selected 0
walk 0 -1 0.4
expect view_centred 0.5

# Drive the real input path, and prove by value that the keys moved the pin
# the selection was on -- not by looking at the picture.
expect pin_selected 0
expect pin_height 0 0
# No pin may start on its target: every bore is one the player has to work.
expect all_pins_free
press right
wait 0.1
expect pin_selected 1
expect pin_free 1
press up
wait 0.1
expect pin_free 1
press up
wait 0.1
expect pin_height 1 2
expect pin_height 0 0
# Two presses put it on its target, so it has dropped into place. From here it
# ignores the keys entirely -- that is the whole shape of the puzzle.
expect pin_locked 1
press up
press up
wait 0.1
expect pin_height 1 2
expect pin_locked 1
expect pick_clear
# The pin that set has to have MOVED on the model, not just in the puzzle: a
# set pin plays its own pop clip, layered over the pick's, and this is that
# clip arriving at the geometry. Rest travel is about 10 mm at the drawn scale,
# so 2 mm is well clear of nothing-happened and well short of asserting on the
# animator's timing.
wait 1.2
expect padlock_pin_moved 1 0.002
report
capture lockpick_03_pins_moved.png

# Drive the selection across every pin and back, checking on every frame that
# the pick is not cutting through the mechanism it is supposed to be working.
sweep_pins
expect pick_clear
capture lockpick_03b_pick_swept.png

# E backs out of a lock as well as into it.
press interact
wait 0.6
expect phase exploring
expect door_shut 0
press interact
wait 1.2
expect phase pin

solve
wait 2.0
expect phase exploring
expect door_open 0
report
capture lockpick_04_gate_open.png

walk_through 0 3.0
report
expect past_door 0
capture lockpick_05_through_the_gate.png

# --- Door 1: the safe ----------------------------------------------------
teleport_door 1
wait 0.5
expect door_shut 1
press interact
wait 2.0
expect phase safe
expect focus 0.98
expect facing 3.0
expect aimed 2.0
report
capture lockpick_06_facing_safe.png

# Four pins on the face, none driven, the selection on the leftmost. Walk it
# with the real keys: the row wraps rather than clamping at its ends.
expect safe_progress 0
expect safe_selected 0
expect safe_pins_flush
press left
wait 0.1
expect safe_selected 3
press right
wait 0.1
expect safe_selected 0

# Drive two pins, and prove by value that they TRAVELLED out toward the player
# -- the pins standing proud are the only thing this lock tells the player, so
# a driven pin that never moved would be a solved-but-silent puzzle.
drive_safe_pins 2
wait 0.5
expect safe_progress 2
expect safe_pins_out 2
report
capture lockpick_06b_safe_two_driven.png

# Pressing a pin the order does not want next springs the whole face back out.
# That is the only way to lose progress here, since moving the selection is
# free. Driven through the real confirm key, not by writing the counter.
select_wrong_pin
expect safe_pin_wrong
press confirm
wait 0.5
expect safe_progress 0
expect safe_pins_out 0
expect safe_pins_flush
expect door_shut 1
report
capture lockpick_06c_safe_reset.png

solve
wait 2.0
expect phase exploring
expect door_open 1
walk_through 1 3.0
expect past_door 1
report
capture lockpick_07_through_second_gate.png
quit
