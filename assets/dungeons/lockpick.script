# Prove, in the real renderer: we can reach a lock, the camera turns to face
# it, the puzzle can be solved, and the player then walks through the gate.
report

# --- Door 0: pin tumbler -------------------------------------------------
facing_of 0
facing_of 1
teleport_door 0
# Aim 130 degrees away from the lock first: if the camera did not turn, the
# facing check below could only pass by luck.
set_yaw 220
wait 0.5
expect phase exploring
expect door_shut 0
capture lockpick_01_approach.png

press interact
wait 2.0
expect phase pin
expect focus 0.98
expect facing 3.0
expect aimed 2.0
expect pins_left_to_right
report
capture lockpick_02_facing_pin_tumbler.png

# Drive the real input path, and prove by value that the keys moved the pin
# the selection was on -- not by looking at the picture.
expect pin_selected 0
expect pin_height 0 0
press right
wait 0.1
expect pin_selected 1
# Pin 1 of this seed's first door starts free with a target two steps up. If a
# generator change ever makes it start set, this fails loudly rather than
# quietly asserting nothing about the keys below.
expect pin_free 1
press up
wait 0.1
expect pin_free 1
press up
wait 0.1
expect pin_height 1 2
expect pin_height 0 0
# Two presses put it on its target, so it has dropped into place. From here it
# ignores the keys entirely -- that is the whole shape of the puzzle.
expect pin_locked 1
press up
press up
wait 0.1
expect pin_height 1 2
expect pin_locked 1
expect pick_clear
report
capture lockpick_03_pins_moved.png

# Drive the selection across every pin and back, checking on every frame that
# the pick is not cutting through the mechanism it is supposed to be working.
sweep_pins
expect pick_clear
capture lockpick_03b_pick_swept.png

# E backs out of a lock as well as into it.
press interact
wait 0.6
expect phase exploring
expect door_shut 0
press interact
wait 1.2
expect phase pin

solve
wait 2.0
expect phase exploring
expect door_open 0
report
capture lockpick_04_gate_open.png

walk_through 0 3.0
report
expect past_door 0
capture lockpick_05_through_the_gate.png

# --- Door 1: vault dial --------------------------------------------------
teleport_door 1
wait 0.5
expect door_shut 1
press interact
wait 2.0
expect phase dial
expect focus 0.98
expect facing 3.0
expect aimed 2.0
report
capture lockpick_06_facing_vault_dial.png

# Turn until the red index pin lights, confirm to bank the number, repeat --
# real held-turn frames and real confirms, not a written progress counter.
expect dial_progress 0
expect dial_pin_dark
spin_to_numbers 2
wait 0.05
expect dial_progress 2
report
capture lockpick_06b_dial_two_banked.png

# Confirming on a dark pin throws the whole combination away. That is the only
# way to lose progress here, since turning the dial costs nothing.
spin_off_number
expect dial_pin_dark
commit_dial
wait 0.05
expect dial_progress 0
expect door_shut 1
report
capture lockpick_06c_dial_reset.png

solve
wait 2.0
expect phase exploring
expect door_open 1
walk_through 1 3.0
expect past_door 1
report
capture lockpick_07_through_second_gate.png
quit
