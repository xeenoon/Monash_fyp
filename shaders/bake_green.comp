#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer InImage { uint px[]; } src;
layout(std430, binding = 1) writeonly buffer OutGreen { float v[]; } dst;
layout(push_constant) uniform Push { uint width; uint height; } pc;
void main() {
    uvec2 q = gl_GlobalInvocationID.xy;
    if (q.x >= pc.width || q.y >= pc.height) return;
    uint i = q.y * pc.width + q.x, p = src.px[i];
    float r = float(p & 0xffu) / 255.0;
    float g = float((p >> 8) & 0xffu) / 255.0;
    dst.v[i] = g - r;
}
