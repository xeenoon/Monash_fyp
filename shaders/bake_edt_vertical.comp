#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer HorizontalOwner { int v[]; } owner;
layout(std430, binding = 1) readonly buffer HorizontalDistance { int v[]; } distance;
layout(std430, binding = 2) writeonly buffer Result { int v[]; } result;
layout(push_constant) uniform Push { uint width; uint height; } pc;
void main() {
    uvec2 q = gl_GlobalInvocationID.xy;
    if (q.x >= pc.width || q.y >= pc.height) return;
    int W = int(pc.width), H = int(pc.height), x = int(q.x), y = int(q.y);
    int best_owner = -1, best_distance = 0x7fffffff;
    for (int sy = 0; sy < H; ++sy) {
        int i = sy * W + x, candidate = owner.v[i];
        if (candidate < 0) continue;
        int dy = y - sy, value = distance.v[i] + dy * dy;
        // Match scipy.ndimage's equal-distance ordering: the last transformed
        // axis (x) wins before y.
        if (value < best_distance ||
            (value == best_distance && candidate % W < best_owner % W)) {
            best_distance = value;
            best_owner = candidate;
        }
    }
    result.v[q.y * pc.width + q.x] = best_owner;
}
