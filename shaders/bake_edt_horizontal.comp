#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer Mask { uint v[]; } mask;
layout(std430, binding = 1) writeonly buffer Owner { int v[]; } owner;
layout(std430, binding = 2) writeonly buffer Distance { int v[]; } distance;
layout(push_constant) uniform Push { uint width; uint height; } pc;
void main() {
    uvec2 q = gl_GlobalInvocationID.xy;
    if (q.x >= pc.width || q.y >= pc.height) return;
    int W = int(pc.width), x = int(q.x), y = int(q.y);
    int best_owner = -1, best_distance = 0x7fffffff;
    for (int sx = 0; sx < W; ++sx) {
        int candidate = y * W + sx;
        if (mask.v[candidate] != 0u) continue;
        int dx = x - sx, value = dx * dx;
        if (value < best_distance ||
            (value == best_distance && candidate < best_owner)) {
            best_distance = value;
            best_owner = candidate;
        }
    }
    uint i = q.y * pc.width + q.x;
    owner.v[i] = best_owner;
    distance.v[i] = best_distance;
}
