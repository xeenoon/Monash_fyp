#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "atmosphere_common.glsl"

layout(set = 1, binding = 5, rgba16f) uniform writeonly image2D output_lut;

layout(local_size_x = 8, local_size_y = 8) in;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(ATM_TRANSMITTANCE_SIZE)))) return;
    vec2 uv = (vec2(pixel) + 0.5) / ATM_TRANSMITTANCE_SIZE;
    float height, mu;
    uv_to_transmittance_params(uv, height, mu);
    vec3 origin = vec3(0.0, height, 0.0);
    vec3 direction = vec3(sqrt(max(1.0 - mu * mu, 0.0)), mu, 0.0);
    float limit = ray_sphere_nearest(origin, direction, atmosphere_top_radius());
    vec3 optical_depth = integrate_optical_depth(origin, direction, limit, 40);
    imageStore(output_lut, pixel, vec4(exp(-optical_depth), 1.0));
}
