#version 450
// Stage-2 residency proof: copy a width×height RGBA8 image (one uint per pixel)
// through the GPU unchanged.  Establishes the 2D (x,y) addressing every later
// per-pixel stage reuses.
layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 0) readonly buffer InImage { uint px[]; } src;
layout(std430, binding = 1) writeonly buffer OutImage { uint px[]; } dst;

layout(push_constant) uniform Push {
    uint width;
    uint height;
} pc;

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.width || p.y >= pc.height) return;
    uint i = p.y * pc.width + p.x;
    dst.px[i] = src.px[i];
}
