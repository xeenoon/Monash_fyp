#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "atmosphere_common.glsl"

layout(set = 1, binding = 0) uniform sampler2D transmittance_lut;
layout(set = 1, binding = 1) uniform sampler2D multiple_lut;
layout(set = 1, binding = 7, rgba16f) uniform writeonly image2D output_lut;

layout(local_size_x = 8, local_size_y = 8) in;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(ATM_SKYVIEW_SIZE)))) return;
    vec2 uv = (vec2(pixel) + 0.5) / ATM_SKYVIEW_SIZE;
    vec3 origin = atmosphere_camera_position();
    float view_mu, light_mu;
    uv_to_skyview_params(uv, length(origin), view_mu, light_mu);
    float view_sin = sqrt(max(1.0 - view_mu * view_mu, 0.0));
    vec3 direction = vec3(view_sin * light_mu, view_mu,
        view_sin * sqrt(max(1.0 - light_mu * light_mu, 0.0)));
    float sun_mu = normalize(-frame.sun_direction.xyz).y;
    vec3 to_sun = vec3(sqrt(max(1.0 - sun_mu * sun_mu, 0.0)), sun_mu, 0.0);
    AtmosphereIntegral result = integrate_atmosphere(
        origin, direction, to_sun, frame.sun_radiance.rgb,
        -1.0, 30, true, true,
        transmittance_lut, multiple_lut);
    imageStore(output_lut, pixel, vec4(result.luminance, 1.0));
}
