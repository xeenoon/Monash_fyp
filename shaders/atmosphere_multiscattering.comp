#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "atmosphere_common.glsl"

layout(set = 1, binding = 0) uniform sampler2D transmittance_lut;
layout(set = 1, binding = 1) uniform sampler2D unused_multiple_lut;
layout(set = 1, binding = 6, rgba16f) uniform writeonly image2D output_lut;

layout(local_size_x = 8, local_size_y = 8) in;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(ATM_MULTISCATTER_SIZE)))) return;
    vec2 uv = (vec2(pixel) + 0.5) / ATM_MULTISCATTER_SIZE;
    uv = vec2(from_sub_uv_to_unit(uv.x, ATM_MULTISCATTER_SIZE.x),
              from_sub_uv_to_unit(uv.y, ATM_MULTISCATTER_SIZE.y));
    float sun_mu = uv.x * 2.0 - 1.0;
    vec3 to_sun = vec3(sqrt(max(1.0 - sun_mu * sun_mu, 0.0)), sun_mu, 0.0);
    float height = atmosphere_bottom_radius() + ATM_PLANET_RADIUS_OFFSET +
        clamp(uv.y, 0.0, 1.0) * (atmosphere_top_radius() -
        atmosphere_bottom_radius() - ATM_PLANET_RADIUS_OFFSET);
    vec3 origin = vec3(0.0, height, 0.0);
    vec3 total_luminance = vec3(0.0);
    vec3 total_transfer = vec3(0.0);

    /* Wicked's pass integrates an 8x8 sphere using 64 z-threads and reduces
       group-shared values. A 4x4 serial sphere is the same donor estimator at
       one quarter the startup cost, appropriate for this compact renderer. */
    const int SQRT_SAMPLES = 4;
    for (int y = 0; y < SQRT_SAMPLES; ++y) {
        for (int x = 0; x < SQRT_SAMPLES; ++x) {
            float theta = 2.0 * ATM_PI * (float(x) + 0.5) / float(SQRT_SAMPLES);
            float phi = ATM_PI * (float(y) + 0.5) / float(SQRT_SAMPLES);
            vec3 direction = vec3(cos(theta) * sin(phi), cos(phi),
                                  sin(theta) * sin(phi));
            AtmosphereIntegral sample_result = integrate_atmosphere(
                origin, direction, to_sun, vec3(1.0), -1.0, 16, false, false,
                transmittance_lut, unused_multiple_lut);
            total_luminance += sample_result.luminance;
            total_transfer += sample_result.multi_scatter_as_one;
        }
    }
    total_luminance /= float(SQRT_SAMPLES * SQRT_SAMPLES);
    total_transfer /= float(SQRT_SAMPLES * SQRT_SAMPLES);
    /* Unreal/Wicked equation 10: sum the geometric series of scattering orders. */
    vec3 all_orders = total_luminance /
        max(vec3(1.0) - total_transfer, vec3(0.05));
    imageStore(output_lut, pixel,
        vec4(all_orders * frame.atmosphere_ground.w, 1.0));
}
