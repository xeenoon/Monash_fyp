#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer A { float v[]; } a;
layout(std430, binding = 1) readonly buffer B { float v[]; } b;
layout(std430, binding = 2) writeonly buffer Out { float v[]; } dst;
layout(push_constant) uniform Push { uint width; uint height; uint channels; } pc;
void main() {
    uvec2 q = gl_GlobalInvocationID.xy;
    if (q.x >= pc.width || q.y >= pc.height) return;
    uint first = (q.y * pc.width + q.x) * pc.channels;
    for (uint c = 0u; c < pc.channels; ++c) {
        uint i = first + c;
        dst.v[i] = a.v[i] - b.v[i];
    }
}
