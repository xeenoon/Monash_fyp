#version 450
// Harness smoke test: out[i] = in[i] * factor.  Integer math so the CPU-side
// unit test can assert an exact match and prove upload -> dispatch -> readback.
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer InBuffer { uint data[]; } src;
layout(std430, binding = 1) writeonly buffer OutBuffer { uint data[]; } dst;

layout(push_constant) uniform Push {
    uint count;
    uint factor;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    dst.data[i] = src.data[i] * pc.factor;
}
