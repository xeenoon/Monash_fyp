#version 450
layout(local_size_x=8,local_size_y=8)in;
layout(std430,binding=0)readonly buffer Labels{uint v[];}labels;
layout(std430,binding=1)writeonly buffer Mask{uint v[];}mask;
layout(push_constant)uniform Push{uint width;uint height;uint material;}pc;
void main(){uvec2 q=gl_GlobalInvocationID.xy;if(q.x>=pc.width||q.y>=pc.height)return;uint i=q.y*pc.width+q.x;mask.v[i]=labels.v[i]==pc.material?0u:1u;}
